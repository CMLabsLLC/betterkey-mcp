{
  "name": "betterkey-mcp",
  "author": "CMLabs LLC",
  "version": "0.1.1",
  "description": "Model Context Protocol (MCP) server exposing BetterKey vehicle data and commands to AI agents.",
  "type": "module",
  "bin": {
    "betterkey-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist/**/*",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "test": "node --test --import tsx $(find src -name '*.test.ts')",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.10.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/CMLabsLLC/betterkey-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/CMLabsLLC/betterkey-mcp/issues"
  },
  "homepage": "https://betterkey.xyz",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "betterkey",
    "vehicle",
    "smartcar",
    "ai-agent"
  ],
  "license": "MIT"
}
